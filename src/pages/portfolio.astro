---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Portfolio from '../components/Portfolio.jsx';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui';

const lang = 'en';
const translations = ui[lang];
---

<Layout title="Portfolio" lang={lang} description="Explore our complete portfolio of social media video content. Real results for gyms, bartenders, auto dealers, construction, and more.">
	<Navbar client:load lang={lang} translations={translations} currentPath={Astro.url.pathname} />
	<main class="pt-20">
		<Portfolio client:load translations={translations} mode="full" />
	</main>
	<Footer />
</Layout>
